/* ====== HELPERS ====== */
function money(n){return "Rs "+Number(n).toLocaleString("en-US");}
function $(id){return document.getElementById(id);}
var sel = {};
var cart = [];
try{ var saved = JSON.parse(localStorage.getItem("ib_cart")||"[]"); if(Array.isArray(saved)) cart = saved; }catch(e){}
function persist(){ try{ localStorage.setItem("ib_cart", JSON.stringify(cart)); }catch(e){} }

/* ====== MENU RENDER ====== */
function cardHTML(ci,ii){
  var cat = MENU[ci], it = cat.items[ii], id = ci+"-"+ii;
  var st = sel[id] || (sel[id]={s:0,f:"Tikka"});
  if(cat.deal){
    var flav = it.f ? '<select class="flav" data-act="flav" data-id="'+id+'" aria-label="Pizza flavour for '+it.n+'"><option'+(st.f==="Tikka"?" selected":"")+'>Tikka</option><option'+(st.f==="Fajita"?" selected":"")+'>Fajita</option></select>' : "";
    return '<div class="card deal" id="c'+id+'"><span class="tag">'+it.n+'</span><ul>'+it.c.map(function(x){return "<li>"+x+"</li>";}).join("")+'</ul>'+flav+
      '<button class="add" data-act="add" data-id="'+id+'"><span>Add to order</span><span>'+money(it.p)+'</span></button></div>';
  }
  var cur = it.s[Math.min(st.s,it.s.length-1)];
  var sizes = "";
  if(it.s.length>1 || (it.s[0].l && it.s.length>1)){
    sizes = '<div class="sizes" role="group" aria-label="Size">'+it.s.map(function(z,k){
      return '<button class="size'+(k===st.s?" on":"")+'" data-act="size" data-id="'+id+'" data-k="'+k+'"><b>'+z.l+'</b>'+money(z.p)+'</button>';
    }).join("")+'</div>';
  } else if(it.s[0].l){
    sizes = '<div class="sizes"><span class="size on" style="cursor:default"><b>'+it.s[0].l+'</b>'+money(it.s[0].p)+'</span></div>';
  }
  return '<div class="card" id="c'+id+'"><div class="row"><div><h4>'+it.n+'</h4></div><span class="price">'+(it.s.length>1?"":money(cur.p))+'</span></div>'+sizes+
    '<button class="add" data-act="add" data-id="'+id+'"><span>Add to order</span><span>'+money(cur.p)+'</span></button></div>';
}
function buildMenu(){
  var tabs = "", html = "";
  MENU.forEach(function(cat,ci){
    tabs += '<a class="tab" href="#cat-'+cat.id+'" data-cat="'+cat.id+'">'+cat.name+'</a>';
    html += '<div class="cat" id="cat-'+cat.id+'"><h3>'+cat.name+'</h3>'+(cat.note?'<p class="note">'+cat.note+'</p>':'')+'<div class="grid">'+
      cat.items.map(function(_,ii){return cardHTML(ci,ii);}).join("")+'</div></div>';
  });
  $("tabs").innerHTML = tabs; $("menuRoot").innerHTML = html;
}
function refreshCard(id){
  var p = id.split("-"); var el = $("c"+id); if(!el) return;
  var tmp = document.createElement("div"); tmp.innerHTML = cardHTML(+p[0],+p[1]);
  el.replaceWith(tmp.firstChild);
}
$("menuRoot").addEventListener("click",function(e){
  var b = e.target.closest("[data-act]"); if(!b) return;
  var id = b.dataset.id, act = b.dataset.act;
  if(act==="size"){ sel[id].s = +b.dataset.k; refreshCard(id); }
  if(act==="add"){ addToCart(id); }
});
$("menuRoot").addEventListener("change",function(e){
  var b = e.target.closest("[data-act='flav']"); if(!b) return;
  sel[b.dataset.id].f = b.value;
});

/* ====== CART ====== */
function addToCart(id){
  var p = id.split("-"), cat = MENU[+p[0]], it = cat.items[+p[1]], st = sel[id];
  var name, price, note = "", key;
  if(cat.deal){ name = it.n; price = it.p; note = it.c.join(", ") + (it.f ? " (" + st.f + ")" : ""); key = name + (it.f?st.f:""); }
  else { var z = it.s[Math.min(st.s,it.s.length-1)]; name = it.n; price = z.p; note = z.l; key = name + "|" + z.l; }
  var found = cart.filter(function(x){return x.key===key;})[0];
  if(found) found.q++; else cart.push({key:key,name:name,note:note,price:price,q:1});
  persist(); renderCart(); toast(name + " added");
}
function totals(){ var n=0,t=0; cart.forEach(function(x){n+=x.q;t+=x.q*x.price;}); return {n:n,t:t}; }
var orderType = "Delivery";
var form = {name:"",phone:"",address:"",notes:""};
function renderCart(){
  var T = totals();
  $("cartN").textContent = T.n; $("barCount").textContent = T.n + (T.n===1?" item":" items"); $("barTotal").textContent = money(T.t);
  $("bar").classList.toggle("show", T.n>0 && !$("drawer").classList.contains("show"));
  if(!cart.length){
    $("cartBody").innerHTML = '<div class="empty">Your order is empty.<br>Add something from the menu to get started.</div>';
    $("cartFoot").innerHTML = ""; return;
  }
  $("cartBody").innerHTML = cart.map(function(x,i){
    return '<div class="line"><div><div class="nm">'+x.name+'</div></div><div class="lp">'+money(x.price*x.q)+'</div>'+
      '<div class="sub">'+x.note+'</div><div class="qty"><button data-q="-1" data-i="'+i+'" aria-label="Remove one '+x.name+'">−</button><span>'+x.q+'</span><button data-q="1" data-i="'+i+'" aria-label="Add one '+x.name+'">+</button></div></div>';
  }).join("") +
  '<div class="total"><span>Subtotal</span><span>'+money(T.t)+'</span></div>'+
  '<div class="fld"><label>How would you like it?</label><div class="seg" id="seg">'+
    ["Delivery","Takeaway","Dine-in"].map(function(o){return '<button type="button" data-o="'+o+'" class="'+(o===orderType?"on":"")+'">'+o+'</button>';}).join("")+'</div></div>'+
  '<div class="fld"><label for="fName">Your name</label><input id="fName" autocomplete="name" value="'+esc(form.name)+'"></div>'+
  '<div class="fld"><label for="fPhone">Phone number</label><input id="fPhone" type="tel" autocomplete="tel" inputmode="tel" value="'+esc(form.phone)+'"></div>'+
  '<div class="fld" id="addrFld" style="'+(orderType==="Delivery"?"":"display:none")+'"><label for="fAddr">Delivery address</label><textarea id="fAddr" rows="2" autocomplete="street-address">'+esc(form.address)+'</textarea></div>'+
  '<div class="fld"><label for="fNotes">Notes (optional)</label><textarea id="fNotes" rows="2" placeholder="Extra spicy, no onions…">'+esc(form.notes)+'</textarea></div>';
  $("cartFoot").innerHTML = '<p class="err" id="err"></p><button class="send" id="send">Send order on WhatsApp</button><p class="hint">Delivery charges and timing are confirmed by the restaurant. Prefer to talk? Call 0344-0488080.</p>';
}
function esc(s){return String(s).replace(/&/g,"&amp;").replace(/"/g,"&quot;").replace(/</g,"&lt;");}
$("cartBody").addEventListener("input",function(e){
  var m = {fName:"name",fPhone:"phone",fAddr:"address",fNotes:"notes"}[e.target.id]; if(m) form[m] = e.target.value;
});
$("cartBody").addEventListener("click",function(e){
  var q = e.target.closest("[data-q]");
  if(q){ var i=+q.dataset.i; cart[i].q += +q.dataset.q; if(cart[i].q<=0) cart.splice(i,1); persist(); renderCart(); return; }
  var o = e.target.closest("[data-o]");
  if(o){ orderType = o.dataset.o; renderCart(); }
});
$("cartFoot").addEventListener("click",function(e){
  if(e.target.id!=="send") return;
  var err = $("err");
  if(!form.name.trim()){ err.textContent = "Enter your name."; $("fName").focus(); return; }
  if(form.phone.replace(/\D/g,"").length<10){ err.textContent = "Enter a valid phone number."; $("fPhone").focus(); return; }
  if(orderType==="Delivery" && !form.address.trim()){ err.textContent = "Enter your delivery address."; $("fAddr").focus(); return; }
  var T = totals();
  var msg = "*New order – Innovative Bite*\n\n" +
    "Name: "+form.name.trim()+"\nPhone: "+form.phone.trim()+"\nType: "+orderType+"\n"+
    (orderType==="Delivery" ? "Address: "+form.address.trim()+"\n" : "") + "\n" +
    cart.map(function(x){return x.q+" x "+x.name+(x.note?" ("+x.note+")":"")+" – "+money(x.price*x.q);}).join("\n") +
    "\n\n*Subtotal: "+money(T.t)+"*" + (form.notes.trim()?"\n\nNotes: "+form.notes.trim():"");
  var url = "https://wa.me/"+WHATSAPP_NUMBER+"?text="+encodeURIComponent(msg);
  var w = null; try{ w = window.open(url,"_blank"); }catch(x){}
  if(!w){ window.location.href = url; }
});

/* drawer */
function openCart(){ $("drawer").classList.add("show"); $("drawer").setAttribute("aria-hidden","false"); $("scrim").classList.add("show"); $("bar").classList.remove("show"); renderCart(); }
function closeCart(){ $("drawer").classList.remove("show"); $("drawer").setAttribute("aria-hidden","true"); $("scrim").classList.remove("show"); renderCart(); }
$("openCart").onclick = openCart; $("barBtn").onclick = openCart; $("closeCart").onclick = closeCart; $("scrim").onclick = closeCart;
document.addEventListener("keydown",function(e){ if(e.key==="Escape") closeCart(); });
var tt; function toast(t){ var el=$("toast"); el.textContent=t; el.classList.add("show"); clearTimeout(tt); tt=setTimeout(function(){el.classList.remove("show");},1400); }

/* ====== HOURS & STATUS (Lahore time) ====== */
function lahoreNow(){
  var parts = new Intl.DateTimeFormat("en-US",{timeZone:"Asia/Karachi",weekday:"long",hour:"numeric",minute:"numeric",hour12:false}).formatToParts(new Date());
  var o = {}; parts.forEach(function(p){o[p.type]=p.value;});
  return {day:o.weekday, mins:(+o.hour%24)*60 + +o.minute};
}
function buildHours(){
  var days = ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"], now;
  try{ now = lahoreNow(); }catch(e){ now = {day:"",mins:0}; }
  $("hours").innerHTML = days.map(function(d){ return '<tr class="'+(d===now.day?"today":"")+'"><td>'+d+'</td><td>1:00 pm – 3:00 am</td></tr>'; }).join("");
}
function updateStatus(){
  var s = $("status"), t = $("statusTxt"), now;
  try{ now = lahoreNow(); }catch(e){ t.textContent = "Open daily 1 pm – 3 am"; return; }
  var open = now.mins >= 13*60 || now.mins < 3*60;
  s.className = "status " + (open?"open":"closed");
  t.textContent = open ? "Open now · kitchen closes at 3 am" : "Closed now · opens at 1 pm";
}

/* tab highlight */
function watchTabs(){
  var links = document.querySelectorAll(".tab"), cats = MENU.map(function(c){return $("cat-"+c.id);});
  if(!("IntersectionObserver" in window)) return;
  var io = new IntersectionObserver(function(es){
    es.forEach(function(en){ if(en.isIntersecting){
      var id = en.target.id.replace("cat-","");
      links.forEach(function(l){ var on = l.dataset.cat===id; l.classList.toggle("active",on); if(on){ var tb=$("tabs"); tb.scrollTo({left:l.offsetLeft-20,behavior:"smooth"}); } });
    }});
  },{rootMargin:"-130px 0px -70% 0px"});
  cats.forEach(function(c){io.observe(c);});
}

buildMenu(); buildHours(); updateStatus(); renderCart(); watchTabs();
setInterval(updateStatus,60000);
</script>
