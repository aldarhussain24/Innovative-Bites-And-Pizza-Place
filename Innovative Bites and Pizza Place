<style>
:root{
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px);
  padding-bottom:env(safe-area-inset-bottom,0px);
  --bg:#F3F3F0; --surface:#FFFFFF; --surface2:#EAEAE5; --text:#191919; --muted:#5F5F58;
  --line:#D9D9D2; --accent:#FFC61A; --accent-ink:#191919; --red:#C8281A; --ok:#1E8E4E;
  --hero:#0E0E0E; --hero-text:#FFFFFF;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --bg:#121212; --surface:#1C1C1B; --surface2:#262624; --text:#F2F2EE; --muted:#A5A59C;
    --line:#333330; --red:#FF6A57; --ok:#4CC97F;
  }
}
:root[data-theme="dark"]{
  --bg:#121212; --surface:#1C1C1B; --surface2:#262624; --text:#F2F2EE; --muted:#A5A59C;
  --line:#333330; --red:#FF6A57; --ok:#4CC97F;
}
*,*::before,*::after{box-sizing:inherit}
html{height:auto;scroll-padding-top:calc(env(safe-area-inset-top,0px) + 64px);scroll-behavior:smooth}
body{margin:0;background:var(--bg);color:var(--text);font-family:'Rubik',system-ui,-apple-system,'Segoe UI',Roboto,Arial,sans-serif;line-height:1.5;-webkit-text-size-adjust:100%}
a{color:inherit}
button{font:inherit;cursor:pointer}
:focus-visible{outline:3px solid var(--accent);outline-offset:2px}
.wrap{max-width:1080px;margin:0 auto;padding:0 18px}
h1,h2,h3{margin:0;line-height:1.1}
.display{font-weight:800;font-style:italic;letter-spacing:-.01em}

/* top bar */
.top{position:sticky;top:env(safe-area-inset-top,0px);z-index:30;background:var(--hero);color:var(--hero-text);border-bottom:2px solid var(--accent)}
.top .wrap{display:flex;align-items:center;justify-content:space-between;height:56px;gap:12px}
.brand{font-weight:800;font-style:italic;font-size:19px;text-decoration:none;white-space:nowrap}
.brand span{color:var(--accent)}
.top nav{display:flex;gap:18px;font-size:14px}
.top nav a{text-decoration:none;opacity:.85}
.top nav a:hover{opacity:1;color:var(--accent)}
.cartbtn{background:var(--accent);color:var(--accent-ink);border:0;border-radius:999px;padding:8px 14px;font-weight:700;font-size:14px;display:flex;gap:8px;align-items:center}
.cartbtn .n{background:var(--accent-ink);color:var(--accent);border-radius:999px;min-width:22px;height:22px;display:inline-grid;place-items:center;font-size:12px;padding:0 6px}
@media(max-width:640px){.top nav{display:none}}

/* hero */
.hero{background:var(--hero);color:var(--hero-text);position:relative;overflow:hidden}
.hero .wrap{padding-top:44px;padding-bottom:44px;display:grid;gap:28px;grid-template-columns:1.3fr 1fr;align-items:center}
.hero h1{font-size:clamp(40px,8vw,84px);font-weight:800;font-style:italic;text-transform:none}
.hero h1 em{display:block;color:var(--accent);font-style:italic}
.hero p.lead{font-size:17px;max-width:44ch;color:#D8D8D0;margin:16px 0 22px}
.status{display:inline-flex;align-items:center;gap:8px;font-size:14px;background:#1E1E1E;border:1px solid #333;border-radius:999px;padding:6px 12px;margin-bottom:18px}
.dot{width:9px;height:9px;border-radius:50%;background:#888}
.status.open .dot{background:#4CC97F;box-shadow:0 0 0 4px rgba(76,201,127,.2)}
.status.closed .dot{background:#FF6A57}
.cta-row{display:flex;flex-wrap:wrap;gap:10px}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;border-radius:12px;padding:12px 18px;font-weight:700;text-decoration:none;border:2px solid transparent;font-size:15px}
.btn.primary{background:var(--accent);color:var(--accent-ink)}
.btn.ghost{border-color:#555;color:#fff;background:transparent}
.btn.ghost:hover{border-color:var(--accent);color:var(--accent)}
.pizza{width:100%;max-width:440px;justify-self:center;position:relative}
.pizza img{width:100%;height:auto;display:block;border-radius:18px;border:3px solid var(--accent);transform:rotate(2deg)}
.facts{background:var(--accent);color:var(--accent-ink)}
.facts .wrap{display:flex;flex-wrap:wrap;gap:8px 28px;padding-top:12px;padding-bottom:12px;font-weight:700;font-size:14px}
@media(max-width:760px){.hero .wrap{grid-template-columns:1fr}.pizza{max-width:100%;order:-1}}

/* menu */
section{padding:44px 0}
.sec-title{font-size:clamp(28px,5vw,40px);margin-bottom:6px}
.sec-sub{color:var(--muted);margin:0 0 22px}
.tabs{position:sticky;top:calc(env(safe-area-inset-top,0px) + 56px);z-index:20;background:var(--bg);border-bottom:1px solid var(--line);margin:0 -18px;padding:10px 18px;overflow-x:auto;display:flex;gap:8px;scrollbar-width:none}
.tabs::-webkit-scrollbar{display:none}
.tab{flex:0 0 auto;border:1.5px solid var(--line);background:var(--surface);color:var(--text);border-radius:999px;padding:7px 14px;font-size:14px;font-weight:500;text-decoration:none}
.tab.active{background:var(--text);color:var(--bg);border-color:var(--text)}
.cat{padding-top:30px}
.cat h3{font-size:26px;font-weight:800;font-style:italic;margin-bottom:4px}
.cat .note{color:var(--muted);font-size:14px;margin:0 0 14px}
.grid{display:grid;gap:12px;grid-template-columns:repeat(auto-fill,minmax(290px,1fr))}
.card{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:14px;display:flex;flex-direction:column;gap:10px}
.card .row{display:flex;justify-content:space-between;gap:10px;align-items:flex-start}
.card h4{margin:0;font-size:17px;font-weight:700}
.card .desc{margin:2px 0 0;color:var(--muted);font-size:13.5px}
.price{font-weight:800;color:var(--text);white-space:nowrap}
.sizes{display:flex;flex-wrap:wrap;gap:6px}
.size{border:1.5px solid var(--line);background:var(--surface2);color:var(--text);border-radius:9px;padding:5px 10px;font-size:13px;line-height:1.25;text-align:center}
.size b{display:block;font-size:12px;font-weight:500;color:var(--muted)}
.size.on{border-color:var(--text);background:var(--accent);color:var(--accent-ink)}
.size.on b{color:#3a3a2a}
select.flav{width:100%;padding:9px 10px;border-radius:9px;border:1.5px solid var(--line);background:var(--surface2);color:var(--text);font:inherit;font-size:14px}
.add{margin-top:auto;background:var(--text);color:var(--bg);border:0;border-radius:10px;padding:10px 12px;font-weight:700;font-size:14px;display:flex;justify-content:space-between;align-items:center}
.add:hover{background:var(--accent);color:var(--accent-ink)}
.deal .tag{align-self:flex-start;background:var(--red);color:#fff;font-weight:800;font-style:italic;font-size:13px;border-radius:7px;padding:3px 9px}
.deal ul{margin:0;padding-left:18px;font-size:14px;color:var(--muted)}
[data-theme="dark"] .deal .tag{color:#111}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]) .deal .tag{color:#111}}

/* info */
.info{background:var(--surface);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.info-grid{display:grid;gap:26px;grid-template-columns:repeat(auto-fit,minmax(260px,1fr))}
.box h3{font-size:20px;margin-bottom:10px}
.hours{width:100%;border-collapse:collapse;font-size:15px}
.hours td{padding:6px 0;border-bottom:1px dashed var(--line)}
.hours td:last-child{text-align:right;font-weight:500}
.hours tr.today td{font-weight:800}
.box p{margin:0 0 8px}
.chips{display:flex;flex-wrap:wrap;gap:8px}
.chip{background:var(--surface2);border-radius:999px;padding:6px 12px;font-size:14px}
.reviews{display:grid;gap:12px;grid-template-columns:repeat(auto-fit,minmax(260px,1fr))}
.rev{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:16px}
.stars{color:#E8A800;letter-spacing:2px}
.rev p{margin:8px 0}
.rev small{color:var(--muted)}
.score{display:flex;align-items:baseline;gap:10px;margin-bottom:16px}
.score b{font-size:44px;font-weight:800}

footer{background:var(--hero);color:#cfcfc7;padding:30px 0 90px;font-size:14px}
footer .wrap{display:flex;flex-wrap:wrap;gap:12px 30px;justify-content:space-between}
footer a{color:var(--accent)}

/* cart */
.scrim{position:fixed;inset:0;background:rgba(0,0,0,.55);z-index:50;display:none}
.scrim.show{display:block}
.drawer{position:fixed;z-index:60;background:var(--surface);color:var(--text);display:flex;flex-direction:column;
  right:0;top:0;bottom:0;width:min(440px,100%);transform:translateX(100%);transition:transform .25s ease;box-shadow:-10px 0 40px rgba(0,0,0,.3);
  padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
.drawer.show{transform:none}
.dh{display:flex;justify-content:space-between;align-items:center;padding:16px 18px;border-bottom:1px solid var(--line)}
.dh h2{font-size:22px}
.x{background:var(--surface2);color:var(--text);border:0;border-radius:50%;width:36px;height:36px;font-size:18px}
.db{flex:1;overflow-y:auto;padding:14px 18px}
.empty{color:var(--muted);text-align:center;padding:30px 10px}
.line{display:grid;grid-template-columns:1fr auto;gap:4px 10px;padding:10px 0;border-bottom:1px solid var(--line)}
.line .nm{font-weight:500}
.line .sub{color:var(--muted);font-size:13px;grid-column:1}
.line .lp{font-weight:700;text-align:right}
.qty{display:flex;align-items:center;gap:8px;grid-column:2;justify-self:end}
.qty button{width:28px;height:28px;border-radius:8px;border:1.5px solid var(--line);background:var(--surface2);color:var(--text);font-weight:800}
.total{display:flex;justify-content:space-between;font-weight:800;font-size:18px;padding:14px 0}
.fld{display:grid;gap:4px;margin-bottom:10px}
.fld label{font-size:13px;font-weight:500;color:var(--muted)}
.fld input,.fld textarea,.fld select{width:100%;padding:10px;border-radius:9px;border:1.5px solid var(--line);background:var(--bg);color:var(--text);font:inherit;font-size:15px}
.seg{display:flex;gap:6px}
.seg button{flex:1;padding:9px 6px;border-radius:9px;border:1.5px solid var(--line);background:var(--surface2);color:var(--text);font-size:14px}
.seg button.on{background:var(--accent);color:var(--accent-ink);border-color:var(--text);font-weight:700}
.df{padding:14px 18px;border-top:1px solid var(--line)}
.send{width:100%;background:#1FA855;color:#fff;border:0;border-radius:12px;padding:14px;font-weight:800;font-size:16px}
.err{color:var(--red);font-size:14px;margin:0 0 8px;min-height:1.2em}
.hint{font-size:12.5px;color:var(--muted);margin:8px 0 0;text-align:center}
.bar{position:fixed;left:12px;right:12px;bottom:calc(env(safe-area-inset-bottom,0px) + 12px);z-index:40;display:none}
.bar button{width:100%;max-width:520px;margin:0 auto;display:flex;justify-content:space-between;background:var(--accent);color:var(--accent-ink);border:2px solid #111;border-radius:14px;padding:13px 16px;font-weight:800;font-size:16px;box-shadow:0 8px 24px rgba(0,0,0,.35)}
.bar.show{display:block}
.toast{position:fixed;left:50%;bottom:calc(env(safe-area-inset-bottom,0px) + 82px);transform:translateX(-50%);background:#111;color:#fff;border-radius:10px;padding:9px 14px;font-size:14px;z-index:70;opacity:0;pointer-events:none;transition:opacity .2s}
.toast.show{opacity:1}
@media (prefers-reduced-motion: reduce){html{scroll-behavior:auto}.drawer{transition:none}}
</style>
</head>
